{
  "name": "majestic-pro",
  "version": "0.0.1",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "ui": "webpack serve --env development --config ./scripts/webpack.ui.config.js",
    "server": "ts-node --project tsconfig.server.json ./server/index.ts",
    "build-server": "cross-env BABEL_ENV=production webpack --env production --config ./scripts/webpack.server.config.js",
    "build-ui": "cross-env BABEL_ENV=production webpack --env production --config ./scripts/webpack.ui.config.js",
    "prod": "npm run build-ui && npm run build-server",
    "watch-server": "nodemon",
    "lint": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "ship": "npm run prod && np --yolo",
    "integration": "cd ./integration && yarn run-in-ci",
    "jest:all": "jest --config jest.config.js --maxWorkers=4",
    "jest:watch": "jest --config jest.config.js --watchAll",
    "jest:coverage": "jest --config jest.config.js --collectCoverage=true --coverageReporters=html",
    "jest:debug": "jest --config jest.config.js --detectOpenHandles --runInBand",
    "jest:fail-fast": "jest --config jest.config.js --bail=1",
    "jest:verbose": "jest --config jest.config.js --verbose",
    "jest:clear-cache": "jest --config jest.config.js --clearCache",
    "jest:run": "jest --config jest.config.js --runInBand",
    "jest:update-snapshots": "jest --config jest.config.js --updateSnapshot",
    "jest:watch-all": "jest --config jest.config.js --watchAll",
    "integration:watch": "npm integration && npm jest:watch",
    "integration:coverage": "npm integration && npm jest:coverage",
    "integration:report": "npm integration && npm jest:coverage && open integration/coverage/index.html",
    "test:unit": "jest --config jest.config.js --testPathPattern=\\\\\\\\.spec\\\\\\\\.ts$",
    "test:integration": "jest --config jest.config.js --testPathPattern=\\\\\\\\.e2e\\\\\\\\.ts$",
    "test:ui": "npm run build-ui && npm run server",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "integration:e2e": "playwright test -c integration/playwright.config.js"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "open": "^8.4.2",
    "read-pkg-up": "^7.0.1"
  },
  "devDependencies": {
    "@apollo/client": "^3.10.4",
    "@babel/core": "^7.24.5",
    "@babel/parser": "^7.24.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.1",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@babel/traverse": "^7.24.5",
    "@tippyjs/react": "^4.2.6",
    "@types/express": "^4.17.21",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-source-maps": "^4.0.4",
    "@types/lodash.throttle": "^4.1.9",
    "@types/minimist": "^1.2.5",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/resolve": "^1.20.6",
    "@types/styled-components": "^5.1.34",
    "@types/styled-system": "^5.1.22",
    "ansi-to-html": "^0.7.2",
    "babel-loader": "^9.1.3",
    "babel-plugin-styled-components": "^2.1.4",
    "chokidar": "^3.6.0",
    "consola": "^3.2.3",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.37.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.1",
    "get-port": "^5.1.1",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^5.16.0",
    "graphql-yoga": "^5.6.0",
    "html-webpack-plugin": "^5.6.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "^5.0.6",
    "launch-editor": "^2.6.1",
    "lodash.throttle": "^4.1.1",
    "minimist": "^1.2.8",
    "nanoid": "^3.3.7",
    "nodemon": "^3.1.3",
    "np": "^10.0.5",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-inspector": "^6.0.2",
    "react-resizable-panels": "^2.0.19",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "reflect-metadata": "^0.1.14",
    "resolve": "^1.22.8",
    "rimraf": "^5.0.7",
    "style-loader": "^4.0.0",
    "styled-components": "^6.1.11",
    "styled-system": "^5.1.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "type-graphql": "^2.0.0-rc.2",
    "typeface-open-sans": "^1.1.13",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "bin": {
    "majestic": "./dist/server/index.js"
  },
  "files": [
    "/dist/**",
    "pnpm-lock.yaml"
  ]
}
